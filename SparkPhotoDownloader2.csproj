<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SparkPhotoDownloader</AssemblyName>
    <RootNamespace>SparkPhotoDownloader</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.0.0</Version>

    <!-- Desktop memory profile, stated rather than inherited. Server GC would allocate a heap
         per core and inflate resident memory several times over for no benefit here; the
         workstation collector with a background thread is what a UI process wants, and makes
         the footprint reproducible across machines with different core counts. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>

    <!-- The project sits at the repository root, so the SDK's default globs would otherwise
         walk the packaging scripts and the published output. artifacts/ in particular holds
         a couple of hundred megabytes per platform. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;build\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- The manifest, the .ico and COM interop are Windows-only. Applying them to a macOS or
       Linux publish is at best ignored and at worst an error, so they are scoped to the
       Windows runtime identifiers (and to a plain build, which targets the host). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))">
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>
</Project>
